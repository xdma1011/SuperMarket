# .NET build output - never committed, regenerated by dotnet restore/build.
bin/
obj/

# Visual Studio local state.
.vs/

# User-specific files.
*.user

# CashierApp local SQLite database (created at runtime, not part of the repo).
*.db
*.db-shm
*.db-wal

# مساحات عمل git worktree مؤقتة لوكلاء Claude الخلفية (كل واحدة checkout
# كامل لـgit لحاله) - أدوات تشغيل الجلسة، لا محتوى مشروع.
.claude/worktrees/
