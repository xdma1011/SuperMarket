<Window x:Class="SupermarketSystem.CashierApp.Views.DrawerOpenReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فتح الصندوق"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <!-- السبب اختياري (28/9/2026): كبسة سبب سريع بتسجّل فورًا، أو اكتب سبب، أو "تسجيل بلا سبب". -->
    <StackPanel Margin="20">
        <TextBlock Text="ليش بدك تفتح الصندوق؟ (اختياري)" FontSize="15" FontWeight="SemiBold" Foreground="#1F1B16" />
        <TextBlock Text="الفتحة بتنسجّل باسمك ووقتها، حتى لو ما في نت (بتنبعت لما يرجع)." FontSize="12"
                   Foreground="#6B6355" Margin="0,4,0,12" TextWrapping="Wrap" />

        <WrapPanel x:Name="QuickReasonsPanel" Margin="0,0,0,10">
            <Button Content="فكّة لزبون" Height="40" MinWidth="120" Margin="0,0,8,8" FontSize="14"
                    Style="{StaticResource SecondaryButton}" Click="QuickReason_Click" />
            <Button Content="تبديل عملة" Height="40" MinWidth="120" Margin="0,0,8,8" FontSize="14"
                    Style="{StaticResource SecondaryButton}" Click="QuickReason_Click" />
            <Button Content="تصحيح خطأ بالدفع" Height="40" MinWidth="120" Margin="0,0,8,8" FontSize="14"
                    Style="{StaticResource SecondaryButton}" Click="QuickReason_Click" />
            <Button Content="طلب من الإدارة" Height="40" MinWidth="120" Margin="0,0,8,8" FontSize="14"
                    Style="{StaticResource SecondaryButton}" Click="QuickReason_Click" />
        </WrapPanel>

        <TextBlock Text="أو اكتب السبب:" FontSize="13" Foreground="#6B6355" />
        <TextBox x:Name="ReasonBox" Height="40" Margin="0,4,0,16" MaxLength="200" KeyDown="ReasonBox_KeyDown" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton" Grid.Column="1" Width="90" Height="40" Content="إلغاء" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" />
            <Button x:Name="OkButton" Grid.Column="3" Width="130" Height="40" Content="تسجيل الفتح"
                    Click="OkButton_Click" />
        </Grid>
    </StackPanel>
</Window>
