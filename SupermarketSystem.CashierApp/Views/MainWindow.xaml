<Window x:Class="SupermarketSystem.CashierApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام الكاشير"
        Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="WelcomeText" Grid.Row="0" FontSize="18" FontWeight="Bold" />
        <Button x:Name="StartSaleButton" Grid.Row="2" Width="200" Height="46" FontSize="15"
                Content="بدء البيع" HorizontalAlignment="Right" Click="StartSaleButton_Click" />
    </Grid>
</Window>
