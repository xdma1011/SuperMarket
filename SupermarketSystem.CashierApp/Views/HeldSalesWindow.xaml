<Window x:Class="SupermarketSystem.CashierApp.Views.HeldSalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الفواتير المعلّقة"
        Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource Surface2Brush}"
        PreviewKeyDown="Window_KeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="الفواتير المعلّقة" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="دبل كليك (أو Enter) على الفاتورة بترجعها للشاشة." FontSize="12" Margin="0,4,0,0"
                           Foreground="{StaticResource Ink2Brush}" />
            </StackPanel>
            <Button x:Name="CloseWindowButton" Grid.Column="1" Width="42" Height="42" Content="×" FontSize="18"
                    Style="{StaticResource SecondaryButton}" Click="CloseWindowButton_Click" />
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="HeldGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAF9F7"
                          FontSize="14" MinRowHeight="40" Typography.NumeralAlignment="Tabular"
                          MouseDoubleClick="HeldGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="وقت التعليق" Binding="{Binding HeldAtLocal, StringFormat={}{0:HH:mm}}" Width="90" />
                        <DataGridTextColumn Header="طلب" Binding="{Binding PreparedTicketNumber}" Width="60" />
                        <DataGridTextColumn Header="الأصناف" Binding="{Binding Summary}" Width="*" />
                        <DataGridTextColumn Header="عدد" Binding="{Binding ItemCount}" Width="55" />
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat={}{0:0.000}}" Width="100" FontWeight="Bold" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="ما في فواتير معلّقة." FontSize="14" Foreground="{StaticResource Ink2Brush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Grid.Column="0" Width="140" Height="42" Content="🗑 حذف المحدَّدة"
                    Style="{StaticResource SecondaryButton}" Click="DeleteButton_Click" />
            <Button x:Name="ResumeButton" Grid.Column="2" Width="170" Height="42" FontSize="14" Content="↩ رجّعها للشاشة"
                    Click="ResumeButton_Click" />
        </Grid>
    </Grid>
</Window>
