<Window x:Class="SupermarketSystem.CashierApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام الكاشير"
        Width="420" Height="480"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">

    <!-- خلفية فاتحة (Surface2Brush) + بطاقة بيضاء مركزية (Surface + ظل خفيف) - بدل نموذج معلَّق بلا إطار واضح -->
    <Grid>
        <Border Background="White" CornerRadius="14" Width="360" Height="420"
                BorderBrush="#E5E2DD" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="4" Direction="270" />
            </Border.Effect>

            <Grid Margin="32,36,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="نظام نقاط البيع" FontSize="21" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="#1F1B16" />
                <TextBlock Grid.Row="2" Text="سجّل دخولك لبدء وردية البيع" FontSize="11.5"
                           HorizontalAlignment="Center" Foreground="#6B6355" />

                <TextBlock Grid.Row="4" Text="اسم المستخدم" FontSize="12" Foreground="#6B6355" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Grid.Row="6" Height="42" />

                <TextBlock Grid.Row="8" Text="كلمة السر" FontSize="12" Foreground="#6B6355" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="10" Height="42" KeyDown="PasswordBox_KeyDown" />

                <TextBlock x:Name="ErrorText" Grid.Row="12" Foreground="#DC2626" FontSize="11.5" TextWrapping="Wrap"
                           Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center" />

                <Button x:Name="LoginButton" Grid.Row="14" Height="44" Content="تسجيل الدخول" FontSize="14"
                        Click="LoginButton_Click" IsDefault="True" />

                <TextBlock x:Name="StatusText" Grid.Row="16" FontSize="10.5" Foreground="#6B6355"
                           HorizontalAlignment="Center" Text="" />
            </Grid>
        </Border>
    </Grid>
</Window>
