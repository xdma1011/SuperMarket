<Window x:Class="SupermarketSystem.CashierApp.Views.PartnerWithdrawalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سحب شريك"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource Surface2Brush}"
        PreviewKeyDown="Window_KeyDown">

    <StackPanel Margin="22">
        <TextBlock Text="سحب شريك من الصندوق" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="الشريك نفسه بيثبت إنه هو (حتى والكاشير داخل بحسابه) - والمبلغ بيطلع من الصندوق."
                   FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" />

        <TextBlock Text="المبلغ (د.أ)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <TextBox x:Name="AmountBox" Height="44" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12" Padding="8,0"
                 VerticalContentAlignment="Center" FlowDirection="LeftToRight" Typography.NumeralAlignment="Tabular" />

        <!-- طرق التحقق (29/9/2026): كود تلغرام والباركود بيبينوا بس لو مفعّلين من إعدادات لوحة الإدارة -->
        <TextBlock Text="طريقة التحقق" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <WrapPanel Margin="0,6,0,10">
            <RadioButton x:Name="PasswordMethodRadio" Content="يوزر وكلمة سر" FontSize="14" Margin="0,0,16,4" IsChecked="True"
                         GroupName="VerifyMethod" Checked="MethodRadio_Checked" />
            <RadioButton x:Name="OtpMethodRadio" Content="كود على تلغرام" FontSize="14" Margin="0,0,16,4"
                         GroupName="VerifyMethod" Checked="MethodRadio_Checked" Visibility="Collapsed" />
            <RadioButton x:Name="BarcodeMethodRadio" Content="باركود الشريك" FontSize="14" Margin="0,0,0,4"
                         GroupName="VerifyMethod" Checked="MethodRadio_Checked" Visibility="Collapsed" />
        </WrapPanel>

        <StackPanel x:Name="PasswordPanel">
            <TextBlock Text="اسم مستخدم الشريك" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <TextBox x:Name="UsernameBox" Height="40" FontSize="15" Margin="0,4,0,10" Padding="8,0"
                     VerticalContentAlignment="Center" FlowDirection="LeftToRight" />

            <TextBlock Text="كلمة السر" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <PasswordBox x:Name="PasswordBox" Height="40" FontSize="15" Margin="0,4,0,10" Padding="8,0"
                         VerticalContentAlignment="Center" FlowDirection="LeftToRight" />
        </StackPanel>

        <StackPanel x:Name="OtpPanel" Visibility="Collapsed">
            <TextBlock Text="الشريك" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="OtpPartnerCombo" Grid.Column="0" Height="40" FontSize="15" DisplayMemberPath="FullName"
                          VerticalContentAlignment="Center" />
                <Button x:Name="SendOtpButton" Grid.Column="2" Height="40" Width="130" FontSize="14" Content="📨 ابعت كود"
                        Style="{StaticResource SecondaryButton}" Click="SendOtpButton_Click" />
            </Grid>

            <TextBlock Text="الكود اللي وصل على تلغرام الشريك" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <TextBox x:Name="OtpCodeBox" Height="44" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,4" Padding="8,0" MaxLength="6"
                     VerticalContentAlignment="Center" FlowDirection="LeftToRight" Typography.NumeralAlignment="Tabular" />
            <TextBlock x:Name="OtpStatusText" FontSize="12" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" Margin="0,0,0,10" />
        </StackPanel>

        <StackPanel x:Name="BarcodePanel" Visibility="Collapsed">
            <TextBlock Text="امسح كرت الشريك (أو اكتب أرقامه)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <PasswordBox x:Name="BarcodeBox" Height="44" FontSize="18" Margin="0,4,0,10" Padding="8,0"
                         VerticalContentAlignment="Center" FlowDirection="LeftToRight" />
        </StackPanel>

        <TextBlock Text="ملاحظة (اختياري)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <TextBox x:Name="NotesBox" Height="38" FontSize="14" Margin="0,4,0,12" Padding="8,0" VerticalContentAlignment="Center" MaxLength="500" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontSize="12.5" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Height="44" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton" Grid.Column="2" Height="44" FontSize="14" Content="تأكيد السحب" Click="ConfirmButton_Click" />
        </Grid>
    </StackPanel>
</Window>
