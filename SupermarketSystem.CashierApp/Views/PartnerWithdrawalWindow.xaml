<Window x:Class="SupermarketSystem.CashierApp.Views.PartnerWithdrawalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سحب شريك"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource Surface2Brush}"
        PreviewKeyDown="Window_KeyDown">

    <StackPanel Margin="22">
        <TextBlock Text="سحب شريك من الصندوق" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="الشريك نفسه بيكتب اسم المستخدم وكلمة السر تبعه - بيثبت إنه هو، حتى والكاشير داخل بحسابه."
                   FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" />

        <TextBlock Text="اسم مستخدم الشريك" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <TextBox x:Name="UsernameBox" Height="40" FontSize="15" Margin="0,4,0,10" Padding="8,0"
                 VerticalContentAlignment="Center" FlowDirection="LeftToRight" />

        <TextBlock Text="كلمة السر" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <PasswordBox x:Name="PasswordBox" Height="40" FontSize="15" Margin="0,4,0,10" Padding="8,0"
                     VerticalContentAlignment="Center" FlowDirection="LeftToRight" />

        <TextBlock Text="المبلغ (د.أ)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <TextBox x:Name="AmountBox" Height="44" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,10" Padding="8,0"
                 VerticalContentAlignment="Center" FlowDirection="LeftToRight" Typography.NumeralAlignment="Tabular" />

        <TextBlock Text="ملاحظة (اختياري)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
        <TextBox x:Name="NotesBox" Height="38" FontSize="14" Margin="0,4,0,12" Padding="8,0" VerticalContentAlignment="Center" MaxLength="500" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontSize="12.5" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Height="44" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton" Grid.Column="2" Height="44" FontSize="14" Content="تأكيد السحب" Click="ConfirmButton_Click" />
        </Grid>
    </StackPanel>
</Window>
