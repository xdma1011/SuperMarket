<Window x:Class="SupermarketSystem.CashierApp.Views.CashClosingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إغلاق الصندوق"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إغلاق الصندوق" FontSize="18" FontWeight="Bold" Foreground="#1F1B16" />
        <TextBlock Grid.Row="2" FontSize="12" Foreground="#6B6355"
                   Text="يقارن الكاش المتوقَّع (حسب النظام) بالمعدود فعليًا بالدرج - عدّ اختياري لباقي طرق الدفع." />

        <TextBlock Grid.Row="4" Text="اليوم التجاري" FontSize="13" Foreground="#1F1B16" />
        <TextBox x:Name="BusinessDateBox" Grid.Row="6" Height="40" FontSize="14" Padding="8,0"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="8" Text="الكاش المعدود فعليًا بالدرج" FontSize="13" Foreground="#1F1B16" />
        <TextBox x:Name="CountedCashBox" Grid.Row="9" Height="40" FontSize="14" Padding="8,0"
                 VerticalContentAlignment="Center" Margin="0,4,0,0" />

        <Border Grid.Row="10" Background="#F8F7F5" CornerRadius="8" BorderBrush="#E5E2DD" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel x:Name="PaymentMethodsPanel" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="ResultText" Grid.Row="12" FontSize="13" TextWrapping="Wrap" Foreground="#1F1B16" />

        <Grid Grid.Row="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CloseButton" Grid.Column="2" Width="90" Height="40" Content="إغلاق"
                    Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" />
            <Button x:Name="SubmitButton" Grid.Column="4" Width="140" Height="40" Content="إتمام التقفيل"
                    Click="SubmitButton_Click" />
        </Grid>
    </Grid>
</Window>
