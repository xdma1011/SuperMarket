<Window x:Class="SupermarketSystem.CashierApp.Views.SaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نقطة البيع"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        WindowState="Maximized">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="BarcodeBox" Grid.Column="0" Height="42" FontSize="16" Padding="10,0"
                     VerticalContentAlignment="Center" Background="White"
                     KeyDown="BarcodeBox_KeyDown" />

            <Button x:Name="AddButton" Grid.Column="2" Height="42" Width="90" Content="إضافة"
                    Style="{StaticResource SecondaryButton}" Click="AddButton_Click" />

            <Button x:Name="SearchByNameButton" Grid.Column="4" Height="42" Width="120" Content="🔍 بحث بالاسم"
                    Style="{StaticResource SecondaryButton}" Click="SearchByNameButton_Click" />

            <TextBlock x:Name="ConnectionStatusText" Grid.Column="6" VerticalAlignment="Center"
                       FontSize="12" Text="" />
        </Grid>

        <!-- لوحة بحث بالاسم - تظهر فوق باقي المحتوى مؤقتًا، تختفي فور اختيار صنف أو الإغلاق -->
        <Border x:Name="SearchPanel" Grid.Row="0" Grid.RowSpan="3" Background="White" BorderBrush="#CCCCCC"
                BorderThickness="1" CornerRadius="8" Visibility="Collapsed" Panel.ZIndex="10"
                VerticalAlignment="Top" Margin="0,52,0,0" MaxHeight="380">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchNameBox" Grid.Column="0" Height="38" FontSize="14" Padding="8,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchNameBox_TextChanged" KeyDown="SearchNameBox_KeyDown" />
                    <Button x:Name="CloseSearchButton" Grid.Column="2" Width="38" Height="38" Content="×" FontSize="16"
                            Style="{StaticResource SecondaryButton}" Click="CloseSearchButton_Click" />
                </Grid>

                <ListBox x:Name="SearchResultsList" Grid.Row="2" MaxHeight="300"
                         MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                         KeyDown="SearchResultsList_KeyDown" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E5E2DD" BorderThickness="1">
            <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAF9F7"
                      Focusable="False" IsHitTestVisible="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="الدفعة" Binding="{Binding BatchNumber}" Width="90" />
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="90" />
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80" />
                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:0.00}}" Width="90" />
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:0.00}}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TotalText" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="22" FontWeight="Bold" Text="الإجمالي: 0.00" Foreground="#1F1B16" />

            <ComboBox x:Name="PaymentMethodCombo" Grid.Column="2" Width="160" Height="38"
                      DisplayMemberPath="Name" VerticalContentAlignment="Center" />

            <TextBlock x:Name="ErrorText" Grid.Column="4" Foreground="#DC2626" FontSize="12"
                       VerticalAlignment="Center" Visibility="Collapsed" />

            <Button x:Name="CompleteSaleButton" Grid.Column="6" Height="42" Width="140"
                    Content="إتمام البيع" FontSize="14" Click="CompleteSaleButton_Click" />
        </Grid>
    </Grid>
</Window>
