<Window x:Class="SupermarketSystem.CashierApp.Views.SaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نقطة البيع"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        WindowState="Maximized">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- باركود، أو كمية*باركود (مثلًا 5*6250000000011) لإضافة 5 مرة وحدة؛ +/− والحقل فاضي بتعدّل آخر سطر -->
            <TextBox x:Name="BarcodeBox" Grid.Column="0" Height="42" FontSize="16" Padding="10,0"
                     VerticalContentAlignment="Center" Background="White"
                     KeyDown="BarcodeBox_KeyDown" ToolTip="باركود، أو كمية*باركود (5*باركود). + و − والحقل فاضي بتعدّل كمية آخر صنف." />

            <Button x:Name="AddButton" Grid.Column="2" Height="42" Width="90" Content="إضافة"
                    Style="{StaticResource SecondaryButton}" Click="AddButton_Click" />

            <!-- باركود غير مطابق أو فاضي بحقل الباركود بيفتح نفس هذه الشاشة تلقائيًا (راجع AddScannedItem بالكود-behind) -->
            <Button x:Name="SearchByNameButton" Grid.Column="4" Height="42" Width="120" Content="🔍 بحث عن صنف"
                    Style="{StaticResource SecondaryButton}" Click="SearchByNameButton_Click" />

            <!-- وضع مستقل: يعرض السعر فقط بلا إضافة للفاتورة - لزبون يسأل عن سعر بينما زبون آخر عالكاش -->
            <Button x:Name="PriceCheckButton" Grid.Column="6" Height="42" Width="120" Content="💰 معرفة السعر"
                    Style="{StaticResource SecondaryButton}" Click="PriceCheckButton_Click" />

            <!-- تفعّل بس لما يتأكد فعليًا وجود اتصال بالسيرفر (فحص دوري خفيف كل بضع ثواني، راجع SaleWindow.xaml.cs) -->
            <Button x:Name="SyncNowButton" Grid.Column="8" Height="42" Width="110" Content="🔄 مزامنة الآن"
                    Style="{StaticResource SecondaryButton}" Click="SyncNowButton_Click" IsEnabled="False" />

            <!-- تظهر بس أثناء مزامنة يدوية شغّالة فعليًا (راجع SyncNowButton_Click) -->
            <Button x:Name="CancelSyncButton" Grid.Column="10" Height="42" Width="80" Content="إلغاء"
                    Style="{StaticResource SecondaryButton}" Click="CancelSyncButton_Click" Visibility="Collapsed" />

            <TextBlock x:Name="ConnectionStatusText" Grid.Column="12" VerticalAlignment="Center"
                       FontSize="12" Text="" />
        </Grid>

        <!-- شريط الإجراءات: عمليات جانبية بلا ما تطلع من شاشة البيع (كانت بتحتاج تسجيل خروج للرجوع للإرجاع/رفع
             فاتورة) + سطر حالة آخر عملية بدل الرسالة المنبثقة بعد كل بيعة. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="HomeButton" Height="34" Width="96" FontSize="12" Content="🏠 القائمة"
                        Style="{StaticResource SecondaryButton}" Click="HomeButton_Click" Margin="0,0,6,0" />
                <Button x:Name="ReturnButton" Height="34" Width="96" FontSize="12" Content="↩ إرجاع"
                        Style="{StaticResource SecondaryButton}" Click="ReturnButton_Click" Margin="0,0,6,0" />
                <Button x:Name="VoidSaleButton" Height="34" Width="112" FontSize="12" Content="✕ إلغاء فاتورة"
                        Style="{StaticResource SecondaryButton}" Click="VoidSaleButton_Click" Margin="0,0,6,0" />
                <!-- طلبات مساعد الكاشير (ضربها من تلفونه) وبحث الفواتير بالوقت (مراجعة الكاميرا) - 28/9/2026 -->
                <Button x:Name="PreparedOrdersButton" Height="34" Width="118" FontSize="12" Content="🛍 طلبات جاهزة"
                        Style="{StaticResource SecondaryButton}" Click="PreparedOrdersButton_Click" Margin="0,0,6,0" />
                <Button x:Name="InvoiceSearchButton" Height="34" Width="118" FontSize="12" Content="🔎 بحث الفواتير"
                        Style="{StaticResource SecondaryButton}" Click="InvoiceSearchButton_Click" Margin="0,0,6,0" />
                <Button x:Name="DrawerOpenButton" Height="34" Width="112" FontSize="12" Content="🗄 فتح الصندوق"
                        Style="{StaticResource SecondaryButton}" Click="DrawerOpenButton_Click" Margin="0,0,6,0" />
                <Button x:Name="CashClosingButton" Height="34" Width="120" FontSize="12" Content="🧮 إغلاق الصندوق"
                        Style="{StaticResource SecondaryButton}" Click="CashClosingButton_Click" Margin="0,0,6,0" />
                <Button x:Name="LogoutButton" Height="34" Width="110" FontSize="12" Content="🔒 تسجيل خروج"
                        Style="{StaticResource SecondaryButton}" Click="LogoutButton_Click" />
            </StackPanel>

            <Border x:Name="SaleStatusBanner" Grid.Column="2" CornerRadius="8" Padding="12,6"
                    HorizontalAlignment="Stretch" Visibility="Collapsed">
                <TextBlock x:Name="SaleStatusText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="White" CornerRadius="10" BorderBrush="#E5E2DD" BorderThickness="1">
            <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAF9F7"
                      Focusable="False" IsHitTestVisible="True" LoadingRow="CartGrid_LoadingRow"
                      FontSize="15" MinRowHeight="42" Typography.NumeralAlignment="Tabular">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="الدفعة" Binding="{Binding BatchNumber}" Width="90" />
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="90" />
                    <!-- الكمية قابلة للتعديل: كتابة مباشرة أو +/− (بدل مسح نفس الصنف 7 مرات) -->
                    <DataGridTemplateColumn Header="الكمية" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="−" Width="30" Height="30" Padding="0" FontSize="16" Focusable="False"
                                            Style="{StaticResource SecondaryButton}" Click="DecreaseQuantity_Click" />
                                    <TextBox Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.###}}"
                                             Width="60" Height="30" Margin="4,0" FontSize="15" FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             LostKeyboardFocus="QuantityBox_LostKeyboardFocus" KeyDown="QuantityBox_KeyDown" />
                                    <Button Content="+" Width="30" Height="30" Padding="0" FontSize="16" Focusable="False"
                                            Style="{StaticResource SecondaryButton}" Click="IncreaseQuantity_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:0.000}}" Width="100" />
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:0.000}}" Width="110" FontWeight="Bold" />
                    <DataGridTextColumn Header="" Binding="{Binding ReviewMark}" Width="90" />
                    <DataGridTemplateColumn Header="" Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Width="30" Height="30" Padding="0" Focusable="False" ToolTip="حذف السطر"
                                        Style="{StaticResource SecondaryButton}" Click="RemoveLine_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- لوحة المبلغ المستلم والفكة - منفصلة بصريًا عن شريط الإجمالي/الدفع، كبيرة وواضحة قدام الزبون والكاشير معًا -->
        <Border Grid.Row="6" Background="#FFF9F0" CornerRadius="10" BorderBrush="#E9C46A" BorderThickness="1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="المبلغ المستلم" FontSize="11" Foreground="#6B6355" />
                    <TextBox x:Name="TenderedAmountBox" Width="130" Height="40" FontSize="18" FontWeight="SemiBold" Padding="8,0"
                             VerticalContentAlignment="Center" TextChanged="TenderedAmountBox_TextChanged"
                             Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="دينار" FontSize="11" Foreground="#6B6355" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="1" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="JodDenominationButton_Click" Tag="1" />
                        <Button Content="5" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="JodDenominationButton_Click" Tag="5" />
                        <Button Content="10" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="JodDenominationButton_Click" Tag="10" />
                        <Button Content="20" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="JodDenominationButton_Click" Tag="20" />
                        <Button Content="50" Width="34" Height="30" FontSize="11"
                                Style="{StaticResource SecondaryButton}" Click="JodDenominationButton_Click" Tag="50" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="دولار" FontSize="11" Foreground="#6B6355" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="1" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="UsdDenominationButton_Click" Tag="1" />
                        <Button Content="5" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="UsdDenominationButton_Click" Tag="5" />
                        <Button Content="10" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="UsdDenominationButton_Click" Tag="10" />
                        <Button Content="20" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="UsdDenominationButton_Click" Tag="20" />
                        <Button Content="50" Width="34" Height="30" FontSize="11" Margin="0,0,3,0"
                                Style="{StaticResource SecondaryButton}" Click="UsdDenominationButton_Click" Tag="50" />
                        <Button Content="100" Width="34" Height="30" FontSize="11"
                                Style="{StaticResource SecondaryButton}" Click="UsdDenominationButton_Click" Tag="100" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="الباقي للزبون" FontSize="12" Foreground="#6B6355" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ChangeAmountText" Text="0.000" FontSize="30" FontWeight="Bold"
                               Foreground="#16A34A" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- الإجمالي أكبر وبلون الهوية الدافي - أهم رقم بالشاشة قدام الكاشير والزبون -->
            <TextBlock x:Name="TotalText" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="32" FontWeight="Bold" Text="الإجمالي: 0.000 د.أ" Foreground="{StaticResource AccentHoverBrush}"
                       Typography.NumeralAlignment="Tabular" />

            <!-- رقم الزبون اختياري (28/9/2026): زبون مسجّل بنفس الرقم = الفاتورة بتنربط فيه، غير هيك الرقم بينحفظ عالفاتورة -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="رقم الزبون (اختياري)" FontSize="11" Foreground="{StaticResource Ink2Brush}" />
                <TextBox x:Name="CustomerPhoneBox" Width="140" Height="34" FontSize="14" Padding="6,0" Margin="0,2,0,0"
                         VerticalContentAlignment="Center" FlowDirection="LeftToRight" MaxLength="20"
                         Typography.NumeralAlignment="Tabular" ToolTip="مثلًا 0791234567 - بيلاقي الزبون المسجّل تلقائيًا" />
            </StackPanel>

            <ComboBox x:Name="PaymentMethodCombo" Grid.Column="4" Width="160" Height="38"
                      DisplayMemberPath="Name" VerticalContentAlignment="Center" />

            <TextBlock x:Name="ErrorText" Grid.Column="6" Foreground="#DC2626" FontSize="12"
                       VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="260" />

            <!-- تعليق فاتورة: زبون بدو يبدّل صنف والطابور واقف - السلة بتنحط على جنب وبترجع بدبل كليك (28/9/2026) -->
            <Button x:Name="HoldButton" Grid.Column="8" Height="42" Width="110" FontSize="13" Content="⏸ تعليق"
                    Style="{StaticResource SecondaryButton}" Click="HoldButton_Click"
                    ToolTip="حط الفاتورة الحالية على جنب وخدّم الزبون اللي بعده" />
            <Button x:Name="HeldSalesButton" Grid.Column="10" Height="42" Width="130" FontSize="13" Content="📋 المعلّقة (0)"
                    Style="{StaticResource SecondaryButton}" Click="HeldSalesButton_Click" />

            <Button x:Name="CompleteSaleButton" Grid.Column="12" Height="42" Width="140"
                    Content="إتمام البيع" FontSize="14" Click="CompleteSaleButton_Click" />
        </Grid>
    </Grid>
</Window>
