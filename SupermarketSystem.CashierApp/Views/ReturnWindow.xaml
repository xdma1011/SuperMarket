<Window x:Class="SupermarketSystem.CashierApp.Views.ReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معالجة إرجاع"
        Width="980" Height="780"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource Surface2Brush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="150" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="معالجة إرجاع" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
            <Button x:Name="CloseWindowButton" Grid.Column="1" Width="42" Height="42" Content="×" FontSize="18"
                    Style="{StaticResource SecondaryButton}" Click="CloseWindowButton_Click" />
        </Grid>

        <!-- شريط البحث عن الفاتورة الأصلية -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTermBox" Grid.Column="0" Height="42" FontSize="14" Padding="10,0"
                     VerticalContentAlignment="Center" Background="White"
                     KeyDown="SearchTermBox_KeyDown" />
            <Button x:Name="SearchButton" Grid.Column="2" Height="42" Width="110" Content="🔍 بحث"
                    Click="SearchButton_Click" />
        </Grid>

        <TextBlock Grid.Row="3" FontSize="11.5" Foreground="{StaticResource Ink2Brush}"
                   Text="ابحث برقم الفاتورة أو رقم هاتف/اسم الزبون - Enter يبحث مباشرة." />

        <!-- نتائج البحث -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="SearchResultsList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="SearchResultsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           FontSize="12" Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CustomerDisplay}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusTitle}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding TotalAmount, StringFormat={}{0:0.00}}"
                                           FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoSearchResultsText" Text="لا يوجد نتائج - جرّب كلمة بحث مختلفة." FontSize="13"
                           Foreground="{StaticResource Ink2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- تفاصيل الفاتورة المختارة وأصنافها -->
        <Border Grid.Row="6" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="InvoiceHeaderText" Grid.Row="0" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" Text="اختر فاتورة من نتائج البحث أعلاه." />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- السبب، الملاحظات، طريقة الاسترجاع، الإجمالي وزر التنفيذ -->
        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="سبب الإرجاع" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <ComboBox x:Name="ReasonCombo" Height="38" DisplayMemberPath="Label" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="طريقة الاسترجاع" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <ComboBox x:Name="RefundMethodCombo" Height="38" DisplayMemberPath="Name" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock Text="ملاحظات (اختياري)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                <TextBox x:Name="NotesBox" Height="38" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalRefundText" FontSize="18" FontWeight="Bold" Text="إجمالي الاسترجاع: 0.00"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontSize="12"
                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="SubmitReturnButton" Grid.Column="2" Height="46" Width="190" FontSize="14"
                        Content="تنفيذ الإرجاع" Click="SubmitReturnButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
