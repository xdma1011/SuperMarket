<Window x:Class="SupermarketSystem.CashierApp.Views.PendingQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الفواتير بانتظار المزامنة"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText" Grid.Column="0" FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="#1F1B16" />

            <Button x:Name="SyncNowButton" Grid.Column="2" Width="130" Height="38" Content="🔄 مزامنة الآن"
                    Style="{StaticResource SecondaryButton}" Click="SyncNowButton_Click" />
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E5E2DD" BorderThickness="1">
            <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAF9F7">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                    <DataGridTextColumn Header="عدد المحاولات" Binding="{Binding AttemptCount}" Width="100" />
                    <DataGridTextColumn Header="آخر محاولة" Binding="{Binding LastAttemptAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                    <DataGridTextColumn Header="آخر خطأ" Binding="{Binding LastErrorMessage}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" FontSize="12" Foreground="#6B6355" />
    </Grid>
</Window>
