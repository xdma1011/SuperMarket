<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SupermarketSystem.CashierApp</RootNamespace>
    <!-- نسخة التطبيق (2-أ بند 2): بتنبعت للسيرفر بترويسة X-Client-Version، والسيرفر بيقارنها بإعداد Cashier.MinimumVersion.
         ارفعها وقت أي تغيير بالعقد مع الـAPI بيخلّي النسخة القديمة ما تشتغل. مش رقم حزمة (§1.2). -->
    <Version>1.1.0</Version>
    <!-- نفس تعليق SupermarketSystem.API.csproj - تحذيرات NuGet استشارية
         (SQLitePCLRaw عبر تبعية SQLite غير مباشرة) وتحذيرات pruning
         (الحزم أصلًا متوفرة بالـshared framework)، لا أخطاء بناء، بس
         Package Manager Console بيوقف الأمر بسببها. -->
    <NoWarn>$(NoWarn);NU1510;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- لدعم أوامر Add-Migration/Update-Database من Package Manager Console
         بفيجوال ستوديو - نفس سبب وجودها بـSupermarketSystem.Infrastructure.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <!-- لدعم ترميز Windows-1256 (عربي) على طابعات ESC/POS - .NET Core
         ما بيشمل الترميزات القديمة افتراضيًا. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <!-- مطلوبة لاستخدام dynamic مع WIA (مسح ضوئي اختياري) عبر late-bound
         COM interop - WiaScannerService.cs. -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
